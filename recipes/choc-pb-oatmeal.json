      "fat": 3.5,
      "satFat": 0.6
    },
    {
      "text": "15g casein vanilla protein powder",
      "kcal": 56,
      "protein": 11.2,
      "carbs": 1.5,
      "fat": 0.8,
      "satFat": 0.2
    },
    {
      "text": "200g skyr or 0.2% Greek yogurt",
      "kcal": 120,
      "protein": 20.0,
      "carbs": 8.0,
      "fat": 0.2,
      "satFat": 0.0
    },
    {
      "text": "20g peanut butter",
      "kcal": 130,
      "protein": 5.0,
      "carbs": 4.0,
      "fat": 10.0,
      "satFat": 1.8
    },
    {
      "text": "10g cocoa powder",
      "kcal": 23,
      "protein": 2.0,
      "carbs": 3.0,
      "fat": 1.4,
      "satFat": 0.8
    },
    {
      "text": "200g skimmed milk",
      "kcal": 70,
      "protein": 7.0,
      "carbs": 10.0,
      "fat": 0.2,
      "satFat": 0.2
    },
    {
      "text": "10g chia seeds (optional)",
      "kcal": 49,
      "protein": 1.7,
      "carbs": 4.2,
      "fat": 3.1,
      "satFat": 0.3
