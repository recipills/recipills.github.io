      "protein": 10.0,
      "carbs": 4.0,
      "fat": 0.1,
      "satFat": 0.0
    },
    {
      "text": "10g cocoa powder",
      "kcal": 23,
      "protein": 2.0,
      "carbs": 3.0,
      "fat": 1.4,
      "satFat": 0.8
    },
    {
      "text": "13g powdered peanuts",
      "kcal": 52,
      "protein": 4.5,
      "carbs": 4.5,
      "fat": 1.6,
