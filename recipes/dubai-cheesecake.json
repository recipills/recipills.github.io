{
  "id": "dubai-cheesecake",
  "title": "Dubai Cheesecake",
  "description": "The viral Dubai-style cheesecake \u2014 rich protein cheesecake topped with dark chocolate sauce, pistachio butter and chopped pistachios.",
  "cuisine": "International",
