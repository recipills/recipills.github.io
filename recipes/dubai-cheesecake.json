      "protein": 1.8,
      "carbs": 2.5,
      "fat": 0.1,
      "satFat": 0.1
    },
    {
      "text": "1g cornstarch",
      "kcal": 0,
      "protein": 0.0,
      "carbs": 0.0,
      "fat": 0.0,
      "satFat": 0.0
    },
    {
      "text": "30g pistachio butter",
      "kcal": 180,
      "protein": 5.4,
      "carbs": 6.6,
      "fat": 15.0,
      "satFat": 1.8
    },
