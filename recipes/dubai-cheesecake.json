      "protein": 44.0,
      "carbs": 12.0,
      "fat": 2.0,
      "satFat": 1.2
    },
    {
      "text": "400g skyr or 0.2% Greek yogurt",
      "kcal": 240,
      "protein": 40.0,
      "carbs": 16.0,
      "fat": 0.4,
      "satFat": 0.0
    },
    {
      "text": "2 eggs (100g)",
      "kcal": 150,
      "protein": 13.0,
      "carbs": 1.0,
      "fat": 11.0,
      "satFat": 3.3
    },
    {
      "text": "60g whey vanilla protein powder",
      "kcal": 228,
      "protein": 48.0,
      "carbs": 4.8,
      "fat": 2.4,
      "satFat": 1.2
    },
    {
      "text": "40g sweetener",
      "kcal": 0,
      "protein": 0.0,
      "carbs": 0.0,
      "fat": 0.0,
      "satFat": 0.0
    },
    {
      "text": "40g dark chocolate",
      "kcal": 220,
      "protein": 2.0,
      "carbs": 18.0,
      "fat": 14.0,
      "satFat": 8.4
    },
    {
      "text": "50g skimmed milk",
