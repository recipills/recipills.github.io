      "fat": 0.0,
      "satFat": 0.0
    },
    {
      "text": "3 tsp granulated sweetener",
      "kcal": 6,
      "protein": 0.0,
      "carbs": 1.5,
      "fat": 0.0,
      "satFat": 0.0
    },
    {
