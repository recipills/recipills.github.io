      <th style="width:50%">Intervention</th>
      <th style="width:20%;text-align:center">Qty</th>
      <th style="width:30%;text-align:right">Total Cost</th>
    </tr></thead><tbody><tr>
        <td>Monitoring & evaluation system</td>
        <td style="text-align:center">&times;10</td>
        <td style="text-align:right">€3,500,000</td>
      </tr></tbody></table><table border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse;width:100%;margin-top:12pt;font-size:11pt;">
    <tbody>
      <tr><td style="color:#555">Total Budget</td><td style="text-align:right">€10,000,000</td></tr>
      <tr><td style="color:#555">Total Allocated</td><td style="text-align:right">€3,500,000</td></tr>
      <tr style="font-weight:bold">
        <td>Remaining Budget</td>
        <td style="text-align:right;color:#28a745">€6,500,000 — Within Budget</td>
      </tr>
    </tbody>
  </table>

