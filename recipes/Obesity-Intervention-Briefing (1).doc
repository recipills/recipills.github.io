
<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="UTF-8">
<style>
  body { font-family: Calibri, sans-serif; font-size: 11pt; color: #1a1a1a; margin: 0; }
  h1 { font-size: 20pt; color: #003865; margin-bottom: 2pt; }
  h2 { font-size: 14pt; color: #003865; border-bottom: 2px solid #003865; padding-bottom: 4pt; margin-top: 20pt; }
  h3 { font-size: 13pt; color: #003865; margin: 14pt 0 4pt 0; }
  p  { font-size: 11pt; line-height: 1.6; margin-bottom: 8pt; }
  .date-sub { font-size: 10pt; color: #666; margin-top: 0; }
  .prompt-note { font-size: 10pt; color: #555; font-style: italic; margin-bottom: 6pt; }
  .empty-field { color: #999; font-style: italic; }
</style>
</head>
<body>
<h1>Obesity Intervention Budget Briefing</h1>
<p class="date-sub">Prepared: 4 June 2026</p>

<h2>Budget Summary</h2>
