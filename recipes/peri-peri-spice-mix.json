  "ingredients": [
    "1 tbsp paprika",
    "1 tbsp onion granules",
    "1 tbsp garlic granules",
    "1 tbsp granulated sweetener",
    "1 tbsp ground coriander",
    "1 tbsp chilli flakes",
    "1½ tsp salt",
    "1½ tsp pepper",
    "1½ tsp dried parsley",
    "1½ tsp dried oregano",
    "1½ tsp cayenne pepper",
    "1½ tsp ground cumin"
  ],
  "steps": [
    "Combine all ingredients; store in a jam jar or airtight container."
  ],
  "notes": "Use in Peri-peri Chicken with Sweetcorn Salsa (p.165). Also great as a rub for meats or seasoning for oven chips.",
