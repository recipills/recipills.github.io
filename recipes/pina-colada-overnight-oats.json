      "protein": 11.2,
      "carbs": 1.5,
      "fat": 0.8,
      "satFat": 0.2
    },
    {
      "text": "150g skyr or 0.2% Greek yogurt",
      "kcal": 90,
      "protein": 15.0,
      "carbs": 6.0,
      "fat": 0.2,
      "satFat": 0.0
    },
    {
      "text": "150g canned pineapple (chopped)",
      "kcal": 90,
      "protein": 0.6,
      "carbs": 22.5,
      "fat": 0.2,
      "satFat": 0.0
    },
    {
      "text": "15g grated coconut",
