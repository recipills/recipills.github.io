      "protein": 0.5,
      "carbs": 2.2,
      "fat": 5.0,
      "satFat": 4.3
    },
    {
      "text": "10g honey",
      "kcal": 30,
      "protein": 0.0,
      "carbs": 8.2,
      "fat": 0.0,
      "satFat": 0.0
    },
    {
      "text": "100g water",
      "kcal": 0,
      "protein": 0.0,
      "carbs": 0.0,
      "fat": 0.0,
      "satFat": 0.0
    }
