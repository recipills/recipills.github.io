{
  "_README": {
    "purpose": "Reusable base-ingredient macro reference. Keyed on normalised base ingredient (quantity stripped). Values are ballpark estimates from standard UK nutritional data, tuned for the reduced-fat/fat-free products common in slimming cookbooks.",
    "fields": "per = [kcal, protein_g, carbs_g, fat_g, satFat_g] for the stated basis; avg_g = typical weight of one item when a recipe gives a count without grams; g100 = optional [kcal,protein,carbs,fat,satFat] per 100g fallback used when a normally-counted item is given by weight.",
    "basis_meanings": {
      "fixed": "per whole ingredient as listed (negligible/fixed amount)",
      "100g": "per 100 g",
      "100ml": "per 100 ml",
      "tsp": "per teaspoon",
      "tbsp": "per tablespoon",
      "unit": "per item",
      "egg": "per egg",
      "slice": "per slice",
      "count": "per item"
    },
    "usage": "Parse quantity+unit from an ingredient line, map to the base name here, scale `per` by the parsed amount. See README extraction notes."
  },
